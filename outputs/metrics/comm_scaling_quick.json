        "n_estimators": 600,
        "learning_rate": 0.03,
        "max_depth": 6,
        "min_child_weight": 5,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "reg_alpha": 0.0,
        "reg_lambda": 1.0,
        "early_stopping_rounds": 40,
        "n_jobs": 4
      }
    },
    "paths": {
      "outputs": "outputs"
    },
