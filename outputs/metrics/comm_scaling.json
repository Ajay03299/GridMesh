      "val": 0.15,
      "test": 0.15
    },
    "features": {
      "lookback": 6,
      "horizon": 3,
      "lagged": [
        "pv",
        "GHI",
        "DNI",
        "DHI",
        "kt",
        "Temperature"
      ],
