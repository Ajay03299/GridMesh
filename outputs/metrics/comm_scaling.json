      "max_site_validation_rmse": 0.25,
      "max_validation_bias": 0.1,
      "max_baseline_rmse_ratio": 2.0,
      "baseline_rmse_floor": 0.1,
      "calibration_window": 72,
      "calibration_tolerance": 0.03,
      "fallback_chain": [
        "last_trusted_model",
        "local_model",
        "smart_persistence"
