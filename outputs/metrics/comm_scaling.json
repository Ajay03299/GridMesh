        0.0,
        0.03
      ],
      "target_noise_std": [
        0.0,
        0.01
      ],
      "history_fraction": [
        0.2,
        1.0
      ]
    },
    "model": {
      "architecture": "mlp",
      "cpu_threads": 1,
      "lookback": 6,
      "sequence_features": 6,
      "target": "residual_smart_persistence",
      "hidden": [
        64,
        64
      ],
      "lr": 0.001,
      "batch_size": 256,
      "epochs": 15,
      "weight_decay": 0.0
    },
    "tree_models": {
      "decision_tree": {
        "max_depth": 8,
        "min_samples_leaf": 30
      },
      "xgboost": {
        "n_estimators": 600,
        "learning_rate": 0.03,
        "max_depth": 6,
        "min_child_weight": 5,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "reg_alpha": 0.0,
        "reg_lambda": 1.0,
        "early_stopping_rounds": 40,
        "n_jobs": 4
      }
    },
    "paths": {
      "outputs": "outputs"
    },
    "federated": {
      "rounds": 3,
      "local_epochs": 1,
      "client_fraction": 1.0,
      "min_clients": 2,
      "max_clients_per_round": 20,
      "neighbourhood_size": 25,
      "dropout_rate": 0.0,
      "select_best": true
    },
    "reliability": {
      "error_tolerance": 0.25,
